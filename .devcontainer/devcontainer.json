{
  "name": "operatarr",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27",
      "installGoTools": true
    },
    "ghcr.io/jsburckhardt/devcontainer-features/rtk:1.0.0": {
      "version": "v0.45.0"
    },
    "ghcr.io/devcontainer-community/devcontainer-features/ripgrep:1.0.3": {
      "version": "15.2.0"
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "LOCALBIN": "/home/vscode/.cache/operatarr/bin"
  }
}
