{
  "name": "operatarr",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27",
      "installGoTools": true
    },
    "ghcr.io/jsburckhardt/devcontainer-features/rtk:1.0.0": {
      "version": "v0.45.0"
    },
    "ghcr.io/devcontainer-community/devcontainer-features/ripgrep:1.0.3@sha256:5fed7bcc70a222974726a47146f257b58cc96240513ed424793457e39bd7448a": {
      "version": "15.2.0"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "make devcontainer-setup",
  // Grants vscode access to the mounted Podman socket. --userns=keep-id is not
  // used because the Docker CLI rejects it, even when backed by Podman.
  "postStartCommand": "sh .devcontainer/post-start.sh",
  "runArgs": [
    // SELinux in the Podman machine otherwise blocks access to the socket.
    "--security-opt=label=disable",
    // Lets the container reach kind's API server on the VM's loopback address.
    "--network=host"
  ],
  "mounts": [
    // Path inside the Podman machine VM; replace 501 with the UID printed by
    // `podman machine ssh id -u`.
    "source=/run/user/501/podman/podman.sock,target=/tmp/host-podman.sock,type=bind"
  ],
  "containerEnv": {
    "LOCALBIN": "/home/vscode/.cache/operatarr/bin",
    "CONTAINER_HOST": "unix:///tmp/host-podman.sock",
    "KIND_EXPERIMENTAL_PROVIDER": "podman",
    "KUBECONFIG": "/home/vscode/.kube/operatarr-e2e"
  }
}
